NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local Docker (default):
DB_HOST=localhost
DB_PORT=5434
DB_NAME=rentflow
DB_USER=postgres
DB_PASSWORD=postgres

# Neon / managed Postgres (preferred in production on Render):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DB_SSL=true
# DB_POOL_MAX=10

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Cross-site cookies (Vercel UI + Render API). Set to none in production.
# COOKIE_SAMESITE=none

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Email / SMTP (optional — needed to share settlements by email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploads
UPLOAD_MAX_MB=10

# Audit logs: keep this many days hot before archive (default 90)
AUDIT_LOG_RETENTION_DAYS=90
